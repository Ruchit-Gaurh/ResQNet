{
  "name": "resqnet-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android --localhost",
    "android:dev-mesh": "EXPO_PUBLIC_MESH_TRANSPORT=DEV_EMULATOR_MESH EXPO_PUBLIC_DEV_MESH_URL=ws://10.0.2.2:8787 expo start --localhost",
    "android:native": "./scripts/with-android-java.sh env EXPO_PUBLIC_MESH_TRANSPORT=NATIVE_BLE ./node_modules/.bin/expo run:android",
    "prebuild:android": "expo prebuild --platform android",
    "apk:debug": "./scripts/with-android-java.sh env NODE_ENV=development EXPO_PUBLIC_MESH_TRANSPORT=NATIVE_BLE ./android/gradlew -p android assembleDebug -PreactNativeArchitectures=arm64-v8a",
    "apk:judge": "./scripts/with-android-java.sh env NODE_ENV=production EXPO_PUBLIC_MESH_TRANSPORT=NATIVE_BLE ./android/gradlew -p android assembleRelease -PreactNativeArchitectures=arm64-v8a -x lintVitalAnalyzeRelease",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-dist/mobile/test/local-first.test.js",
    "build": "expo export --platform android --output-dir dist"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-crypto": "~57.0.3",
    "expo-image-picker": "~57.0.17",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  }
}
