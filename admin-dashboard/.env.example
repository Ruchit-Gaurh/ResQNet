# Hosted ResQNet backend origin. Do not append /api/v1.
VITE_API_BASE_URL=https://resqnet-backend-2gof.onrender.com

# Optional local Vite proxy target. Local development uses this proxy by default.
VITE_API_PROXY_TARGET=https://resqnet-backend-2gof.onrender.com

# Never put JWT_SECRET or ADMIN_ACCESS_KEY in VITE_* variables.
