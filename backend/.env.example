# ============================================
# RESQNET Backend — Environment Configuration
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/resqnet

# JWT Authentication
JWT_SECRET=your-jwt-secret-here-change-in-production

# Responder dashboard sign-in key (never expose as VITE_* frontend configuration)
ADMIN_ACCESS_KEY=replace-with-a-long-random-admin-access-key

# Server
PORT=3000
NODE_ENV=development

# Matching Engine (optional thresholds)
MATCH_THRESHOLD_STRONG=80
MATCH_THRESHOLD_POSSIBLE=60
MATCH_THRESHOLD_WEAK=40

# Optional second-stage report similarity assessment. Keep the real key only
# in the backend/Render environment; never expose it through mobile or VITE_*.
OPENAI_API_KEY=replace-me-with-a-server-side-openai-key
OPENAI_MATCH_MODEL=gpt-5-mini
