# ============================================
# RESQNET Backend — Environment Configuration
# ============================================
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/resqnet

# JWT Authentication
JWT_SECRET=your-jwt-secret-here-change-in-production

# Server
PORT=3000
NODE_ENV=development

# Matching Engine (optional thresholds)
MATCH_THRESHOLD_STRONG=80
MATCH_THRESHOLD_POSSIBLE=60
MATCH_THRESHOLD_WEAK=40
